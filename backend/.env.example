# ──────────────────────────────────────────────────────────────────
# INFRASTRUCTURE ONLY. Everything about the site's content, branding,
# contact info, hours, feature toggles, etc. is configured through the
# admin panel at runtime, not here — see app/settings_registry.py.
# ──────────────────────────────────────────────────────────────────

ENVIRONMENT=development

# sqlite:///./data/jdk.db for local dev (default if unset).
# mysql+pymysql://user:pass@host:3306/dbname in prod (driver bundled via
# requirements.txt). postgresql://user:pass@host:5432/dbname also works.
# Use utf8mb4 on the MySQL database itself (CHARACTER SET utf8mb4) — see
# backend/MIGRATING_TO_MYSQL.md before switching an existing dev DB over.
DATABASE_URL=mysql+pymysql://jdk:change-me@localhost:3306/jdk

HOST=127.0.0.1
PORT=7001

# Comma-separated. Leave empty for same-origin only.
ALLOWED_ORIGINS=http://localhost:5173

# Generate both with: python scripts/gen_secrets.py
# Required in production; auto-generated ephemerally in dev if left blank.
SECRET_KEY=
ENCRYPTION_KEY=

# Bootstrap admin — only used by scripts/init_db.py on first run, when no
# admin account exists yet. Get the hash from scripts/gen_secrets.py.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD_HASH=

SESSION_TTL_SECONDS=3600
# false only for local http-only dev
COOKIE_SECURE=true
# Required (must be true) whenever COOKIE_SECURE=true in production — an
# explicit acknowledgment that TLS (nginx/caddy/etc) actually terminates
# in front of this app. Startup refuses to run without it, because a
# plain-HTTP prod deploy with COOKIE_SECURE=true used to fail *silently*
# (browsers just drop the Secure cookie — login looks like it works but
# never actually authenticates). Set up HTTPS first, then set this true.
BEHIND_TLS_PROXY=false

RATE_LIMIT_LOGIN=5/minute
