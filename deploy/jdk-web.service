# systemd unit for the JDK backend (serves the public site, /admin,
# and the API on one port via start_server.sh -> a single uvicorn
# process, no gunicorn/worker pool).
#
# This is an ALTERNATIVE to running it under PM2 (see
# ecosystem.config.js) — pick one process manager, never both at once,
# or they'll fight over the port and over restarting the process.
#
# Install:
#   sudo cp deploy/jdk-web.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/jdk-web.service   # fix the paths/User below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jdk-web
#
# Logs:  journalctl -u jdk-web -f

[Unit]
Description=JDK web app (FastAPI + built frontend)
After=network.target mysql.service
# Remove the line above if you're using SQLite / a remote DB.

[Service]
Type=simple
# Run as a dedicated non-root user, not root.
User=www-data
Group=www-data
WorkingDirectory=/opt/jdk_web
ExecStart=/opt/jdk_web/start_server.sh
Restart=on-failure
RestartSec=5
# Without this, systemd treats ANY signal-terminated exit — including a
# plain `kill <pid>` or `kill -9` run outside systemctl — as a failure
# and immediately relaunches the process, so the service looks like it
# "refuses to die" (and reads as malware persistence to AV/EDR
# heuristics). This keeps real crashes (non-zero Python exit codes)
# auto-restarting while letting a direct kill actually stop it; use
# `systemctl stop jdk-web` for the normal, non-signal-racing shutdown.
SuccessExitStatus=SIGTERM SIGINT SIGKILL

[Install]
WantedBy=multi-user.target
